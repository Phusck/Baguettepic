<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#7A1518</Color>
    <Color x:Key="PrimaryDark">#C9A84C</Color>
    <Color x:Key="PrimaryDarkText">#1A1210</Color>
    <Color x:Key="Secondary">#E4D5B5</Color>
    <Color x:Key="SecondaryDarkText">#C9A84C</Color>
    <Color x:Key="Tertiary">#4A0E10</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#9B2330</Color>
    <Color x:Key="MidnightBlue">#1A1210</Color>
    <Color x:Key="OffBlack">#120E0C</Color>
    <Color x:Key="Danger">#B42318</Color>
    <Color x:Key="PageBackground">#E8DCC8</Color>
    <Color x:Key="PageBackgroundDark">#120E0C</Color>
    <Color x:Key="Ink">#1A1210</Color>
    <Color x:Key="Gold">#C9A84C</Color>
    <Color x:Key="Brass">#8A6A32</Color>

    <Color x:Key="Gray100">#EDE4D4</Color>
    <Color x:Key="Gray200">#D4C8B4</Color>
    <Color x:Key="Gray300">#B8A994</Color>
    <Color x:Key="Gray400">#9A8A74</Color>
    <Color x:Key="Gray500">#6F6254</Color>
    <Color x:Key="Gray600">#4A4036</Color>
    <Color x:Key="Gray900">#241E1A</Color>
    <Color x:Key="Gray950">#120E0C</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
