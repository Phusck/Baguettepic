<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Baguettepic.Models"
             x:Class="Baguettepic.Pages.TitanWeaponPickerPage"
             Title="Add Weapon">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gold}}"
                    StrokeShape="Rectangle"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="12,4">
                <Entry x:Name="SearchEntry"
                       Placeholder="Search weapons"
                       FontSize="22"
                       FontFamily="OpenSansRegular"
                       ReturnType="Go"
                       ClearButtonVisibility="WhileEditing"
                       TextChanged="OnSearchTextChanged"
                       Completed="OnSearchCompleted" />
            </Border>

            <Label x:Name="StatusLabel"
                   Grid.Row="1"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <Grid Grid.Row="2">
                <CollectionView x:Name="WeaponsList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TitanWeaponOption">
                            <VerticalStackLayout Padding="4,14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout>
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnWeaponTapped" CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource Title}"
                                                   FontSize="18"
                                                   LineBreakMode="WordWrap" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding CostText}"
                                                   FontSize="14"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                        </Grid>
                                        <Label Text="{Binding DetailText}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="Add"
                                            VerticalOptions="Center"
                                            Clicked="OnAddClicked" />
                                </Grid>
                                <BoxView HeightRequest="1"
                                         Margin="0,14,0,0"
                                         Color="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gray600}}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No weapons match."
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="24" />
                    </CollectionView.EmptyView>
                </CollectionView>

                <ActivityIndicator x:Name="BusyIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>
        </Grid>

        <Border x:Name="AddedToast"
                IsVisible="False"
                InputTransparent="True"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="20,12"
                Opacity="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray900}}"
                Stroke="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Gold}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 4">
            <Label x:Name="AddedToastLabel"
                   InputTransparent="True"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gold}}" />
        </Border>
    </Grid>
</ContentPage>
