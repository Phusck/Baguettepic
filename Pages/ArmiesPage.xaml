<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Baguettepic.Models"
             x:Class="Baguettepic.Pages.ArmiesPage"
             Title="Load Army">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <Label x:Name="StatusLabel"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

        <Grid Grid.Row="1">
            <CollectionView x:Name="ArmiesList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ArmyListItem">
                        <VerticalStackLayout Padding="4,14">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArmyTapped" CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Name}"
                                   Style="{StaticResource Title}"
                                   FontSize="20"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding SummaryText}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <BoxView HeightRequest="1"
                                     Margin="0,14,0,0"
                                     Color="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gray600}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No armies saved."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="24" />
                </CollectionView.EmptyView>
            </CollectionView>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
