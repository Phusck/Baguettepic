<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Baguettepic.Models"
             x:Class="Baguettepic.Pages.FormationDetachmentsPage"
             Title="Detachments">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Label x:Name="NameLabel" Style="{StaticResource Title}" />
        <Label x:Name="StatusLabel"
               Grid.Row="1"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

        <Grid Grid.Row="2">
            <ScrollView>
                <VerticalStackLayout x:Name="DetachmentsHost" Spacing="20">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:DetachmentGroup">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding DetachmentName}"
                                       Style="{StaticResource Title}"
                                       FontSize="20"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding Summary}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Bases}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:DetachmentBaseRow">
                                            <VerticalStackLayout Padding="4,12">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnBaseTapped" CommandParameter="{Binding .}" />
                                                </VerticalStackLayout.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding DetailText}"
                                                           FontSize="18"
                                                           LineBreakMode="WordWrap" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding ClassText}"
                                                           FontSize="14"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                </Grid>
                                                <BoxView HeightRequest="1"
                                                         Margin="0,12,0,0"
                                                         Color="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gray600}}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="No base profiles for this detachment."
                                       IsVisible="{Binding HasNoBases}"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
