<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Baguettepic.Pages.CreateArmyPage"
             Title="Create Army">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <VerticalStackLayout Spacing="6">
                <Label Text="Name" FontSize="16" />
                <Entry x:Name="NameEntry"
                       Placeholder="Army name"
                       FontSize="18" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Codex" FontSize="16" />
                <Picker x:Name="CodexPicker"
                        Title="Choose a Codex"
                        ItemDisplayBinding="{Binding Name}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Points limit" FontSize="16" />
                <Entry x:Name="PointsEntry"
                       Text="3000"
                       Keyboard="Numeric"
                       FontSize="18" />
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="{StaticResource Danger}" />

            <Button Text="Create"
                    Clicked="OnCreateClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
