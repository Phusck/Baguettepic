<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Baguettepic.Models"
             x:Class="Baguettepic.Pages.ArmyBuilderPage"
             Title="Army">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">
        <VerticalStackLayout Spacing="4">
            <Label x:Name="NameLabel" Style="{StaticResource Title}" />
            <Label x:Name="SummaryLabel"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        </VerticalStackLayout>

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

        <Grid Grid.Row="2">
            <CollectionView x:Name="EntriesList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ArmyEntry">
                        <VerticalStackLayout Padding="4,14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding FormationName}"
                                       Style="{StaticResource Title}"
                                       FontSize="18"
                                       LineBreakMode="WordWrap" />
                                <Label Grid.Column="1"
                                       Text="{Binding CostText}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </Grid>
                            <Label Text="{Binding DetailText}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                                <Button Text="−"
                                        WidthRequest="56"
                                        Clicked="OnMinusClicked" />
                                <Button Text="+"
                                        WidthRequest="56"
                                        Clicked="OnPlusClicked" />
                                <Button Text="Remove"
                                        Clicked="OnRemoveClicked" />
                                <Button Text="Bases"
                                        Clicked="OnBasesClicked" />
                            </HorizontalStackLayout>
                            <BoxView HeightRequest="1"
                                     Margin="0,14,0,0"
                                     Color="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gray600}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No formations yet. Add one from the Codex."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="24" />
                </CollectionView.EmptyView>
            </CollectionView>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <Button Grid.Row="3"
                Text="Add Formation"
                Clicked="OnAddFormationClicked" />
    </Grid>
</ContentPage>
