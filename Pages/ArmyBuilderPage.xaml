<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Baguettepic.Models"
             x:Class="Baguettepic.Pages.ArmyBuilderPage"
             Title="Army">

    <ContentPage.Resources>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinimumHeightRequest" Value="36" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="NameLabel" Style="{StaticResource Title}" />
                    <Label x:Name="SummaryLabel"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    <VerticalStackLayout x:Name="FactionAbilitiesHost"
                                         Spacing="8"
                                         IsVisible="False"
                                         Margin="0,8,0,0">
                        <Label Text="Special abilities" FontSize="16" />
                        <FlexLayout x:Name="FactionAbilitiesLayout"
                                    Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Start" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Edit"
                        VerticalOptions="Start"
                        Clicked="OnEditClicked" />
            </Grid>

            <Label x:Name="StatusLabel"
                   Grid.Row="1"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <Grid Grid.Row="2">
                <CollectionView x:Name="EntriesList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ArmyEntry">
                            <VerticalStackLayout Padding="4,14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding FormationName}"
                                           Style="{StaticResource Title}"
                                           FontSize="18"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Column="1"
                                           Text="{Binding CostText}"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                </Grid>
                                <Label Text="{Binding DetailText}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                                    <Button Text="−"
                                            WidthRequest="56"
                                            Clicked="OnMinusClicked" />
                                    <Button Text="+"
                                            WidthRequest="56"
                                            Clicked="OnPlusClicked" />
                                    <Button Text="Remove"
                                            Clicked="OnRemoveClicked" />
                                    <Button Text="Bases"
                                            Clicked="OnBasesClicked" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout IsVisible="{Binding HasTitans}"
                                                     Margin="0,10,0,0">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Titans}"
                                                         Spacing="10">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ArmyTitanSlot">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding Header}"
                                                           FontSize="15"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnTitanTapped" CommandParameter="{Binding .}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Weapons}"
                                                                         Spacing="4">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ArmyTitanWeaponItem">
                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                                    <Label Text="{Binding Name}"
                                                                           FontSize="15"
                                                                           VerticalOptions="Center"
                                                                           LineBreakMode="WordWrap">
                                                                        <Label.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="OnWeaponTapped" CommandParameter="{Binding .}" />
                                                                        </Label.GestureRecognizers>
                                                                    </Label>
                                                                    <Label Grid.Column="1"
                                                                           Text="{Binding CostText}"
                                                                           FontSize="14"
                                                                           VerticalOptions="Center"
                                                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                                    <Button Grid.Column="2"
                                                                            Text="Remove"
                                                                            Clicked="OnRemoveWeaponClicked" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                    <Button Text="Add Weapon"
                                                            IsVisible="{Binding CanAdd}"
                                                            HorizontalOptions="Start"
                                                            Clicked="OnAddWeaponClicked" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1"
                                         Margin="0,14,0,0"
                                         Color="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gray600}}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No formations yet. Add one from the Codex."
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="24" />
                    </CollectionView.EmptyView>
                </CollectionView>

                <ActivityIndicator x:Name="BusyIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>

            <Button Grid.Row="3"
                    Text="Add Formation"
                    Clicked="OnAddFormationClicked" />
        </Grid>

        <Grid x:Name="EditOverlay"
              IsVisible="False"
              BackgroundColor="#99000000">
            <Border HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    Margin="24"
                    Padding="20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Edit Army"
                           Style="{StaticResource Title}"
                           FontSize="20" />
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Name" FontSize="16" />
                        <Entry x:Name="EditNameEntry"
                               Placeholder="Army name"
                               FontSize="18" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Max Points" FontSize="16" />
                        <Entry x:Name="EditPointsEntry"
                               Keyboard="Numeric"
                               FontSize="18" />
                    </VerticalStackLayout>
                    <Label x:Name="EditErrorLabel"
                           IsVisible="False"
                           TextColor="{StaticResource Danger}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Cancel" Clicked="OnEditCancelClicked" />
                        <Button Grid.Column="1" Text="Save" Clicked="OnEditSaveClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
