<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Baguettepic.Models"
             x:Class="Baguettepic.Pages.FormationPickerPage"
             Title="Add Formation">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Border StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gold}}"
                StrokeShape="Rectangle"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                Padding="12,4">
            <Entry x:Name="SearchEntry"
                   Placeholder="Search formations"
                   FontSize="22"
                   FontFamily="OpenSansRegular"
                   ClearButtonVisibility="WhileEditing"
                   TextChanged="OnSearchTextChanged" />
        </Border>

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

        <Grid Grid.Row="2">
            <CollectionView x:Name="FormationsList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FormationOption">
                        <VerticalStackLayout Padding="4,14">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFormationTapped" CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource Title}"
                                       FontSize="18"
                                       LineBreakMode="WordWrap" />
                                <Label Grid.Column="1"
                                       Text="{Binding CostText}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </Grid>
                            <Label Text="{Binding DetailText}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <BoxView HeightRequest="1"
                                     Margin="0,14,0,0"
                                     Color="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gray600}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No formations match."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="24" />
                </CollectionView.EmptyView>
            </CollectionView>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
