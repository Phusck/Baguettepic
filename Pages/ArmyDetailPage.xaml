<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Baguettepic.Models"
             x:Class="Baguettepic.Pages.ArmyDetailPage"
             Title="Army">

    <ContentPage.Resources>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinimumHeightRequest" Value="36" />
            <Setter Property="MinimumWidthRequest" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">
        <VerticalStackLayout Spacing="4">
            <Label x:Name="NameLabel"
                   Style="{StaticResource Title}" />
            <Label x:Name="SummaryLabel"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            <VerticalStackLayout x:Name="FactionAbilitiesHost"
                                 Spacing="8"
                                 IsVisible="False"
                                 Margin="0,8,0,0">
                <Label Text="Special abilities" FontSize="16" />
                <FlexLayout x:Name="FactionAbilitiesLayout"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Label x:Name="StatusLabel"
               Grid.Row="1"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

        <Grid Grid.Row="2">
            <CollectionView x:Name="EntriesList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ArmyEntry">
                        <VerticalStackLayout Padding="4,14">
                            <VerticalStackLayout>
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEntryTapped" CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding FormationName}"
                                           Style="{StaticResource Title}"
                                           FontSize="18"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Column="1"
                                           Text="{Binding CostText}"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                </Grid>
                                <Label Text="{Binding DetailText}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding HasTitans}"
                                                 Margin="0,8,0,0">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Titans}"
                                                     Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ArmyTitanSlot">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Header}"
                                                       FontSize="15"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTitanTapped" CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Weapons}"
                                                                     Spacing="2">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ArmyTitanWeaponItem">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <Label Text="{Binding Name}"
                                                                       FontSize="15"
                                                                       LineBreakMode="WordWrap">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnWeaponTapped" CommandParameter="{Binding .}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                                <Label Grid.Column="1"
                                                                       Text="{Binding CostText}"
                                                                       FontSize="14"
                                                                       VerticalOptions="Center"
                                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1"
                                     Margin="0,14,0,0"
                                     Color="{AppThemeBinding Light={StaticResource Brass}, Dark={StaticResource Gray600}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator x:Name="BusyIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <Button Grid.Row="3"
                Text="Edit"
                Clicked="OnEditClicked" />
    </Grid>
</ContentPage>
