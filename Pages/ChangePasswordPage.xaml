<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Baguettepic.Pages.ChangePasswordPage"
             Title="Change Password"
             Shell.NavBarIsVisible="False">

    <Grid>
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="360"
            Padding="24"
            Spacing="16">

            <Label Text="Choose a password"
                   Style="{StaticResource Headline}"
                   HorizontalTextAlignment="Center" />
            <Label Text="You must set a new password before continuing."
                   Style="{StaticResource SubHeadline}"
                   HorizontalTextAlignment="Center" />

            <VerticalStackLayout Spacing="8" Margin="0,12,0,0">
                <Label Text="New password" />
                <Entry x:Name="PasswordEntry"
                       IsPassword="True"
                       Placeholder="New password"
                       ReturnType="Go"
                       Completed="OnSaveClicked" />
            </VerticalStackLayout>

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="{StaticResource Danger}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Save password"
                    Clicked="OnSaveClicked" />

            <Button Text="Logout"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    BorderColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                    FontSize="14"
                    HeightRequest="36"
                    MinimumHeightRequest="36"
                    Padding="12,4"
                    HorizontalOptions="Center"
                    Clicked="OnLogoutClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
