<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Baguettepic.Pages.MainMenuPage"
             Title="Main Menu"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24" RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,12,0,24">
            <Label Text="Baguettepic"
                   Style="{StaticResource Headline}"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="RoleLabel"
                   Style="{StaticResource SubHeadline}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="16"
                             VerticalOptions="Start"
                             MaximumWidthRequest="420"
                             HorizontalOptions="Center">
            <Button Text="Rules"
                    FontSize="18"
                    HeightRequest="56"
                    Clicked="OnRulesClicked" />
            <Button Text="Create Army"
                    FontSize="18"
                    HeightRequest="56"
                    Clicked="OnCreateArmyClicked" />
            <Button Text="Load Army"
                    FontSize="18"
                    HeightRequest="56"
                    Clicked="OnLoadArmyClicked" />
        </VerticalStackLayout>

        <Button Grid.Row="2"
                Text="Logout"
                BackgroundColor="Transparent"
                BorderWidth="0"
                BorderColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                FontSize="14"
                HeightRequest="36"
                MinimumHeightRequest="36"
                Padding="12,4"
                HorizontalOptions="Center"
                Margin="0,0,0,8"
                Clicked="OnLogoutClicked" />
    </Grid>
</ContentPage>
